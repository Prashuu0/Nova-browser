{
  "name": "nova-browser",
  "version": "1.0.0",
  "description": "Nova Browser - Privacy-focused AI-powered desktop browser",
  "main": "dist-electron/main/index.js",
  "author": "Nova Browser Team",
  "license": "MIT",
  "engines": {
    "node": ">=26.3.1"
  },
  "scripts": {
    "dev": "node scripts/build-main.cjs && vite",
    "build": "node scripts/build-main.cjs && vite build && electron-builder",
    "build:win": "node scripts/build-main.cjs && vite build && electron-builder --win",
    "build:portable": "node scripts/build-main.cjs && vite build && electron-builder --win portable",
    "build:mac": "node scripts/build-main.cjs && vite build && electron-builder --mac",
    "build:linux": "node scripts/build-main.cjs && vite build && electron-builder --linux",
    "build:netlify": "vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "jest",
    "test:e2e": "playwright test",
    "cloud:install": "cd nova-cloud && npm install",
    "cloud:dev": "cd nova-cloud && npm run dev",
    "cloud:migrate": "cd nova-cloud && npm run migrate",
    "cloud:seed": "cd nova-cloud && npm run seed",
    "cloud:docker": "cd nova-cloud && docker-compose up -d",
    "start:nova": "node scripts/start-nova.cjs",
    "go": "node scripts/start-nova.cjs",
    "team:setup": "node scripts/team-setup.cjs",
    "ai:dev": "cd nova-ai && npm run dev",
    "ai:install": "cd nova-ai && npm install",
    "build:beta": "node scripts/build-main.cjs && vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "better-sqlite3": "^11.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.novabrowser.app",
    "productName": "Nova Browser",
    "copyright": "Copyright © 2026 Nova Browser",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "NovaBrowser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Browser"
    },
    "portable": {
      "artifactName": "NovaBrowser-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "publish": {
      "provider": "github",
      "owner": "nova-browser",
      "repo": "nova-browser"
    }
  }
}
