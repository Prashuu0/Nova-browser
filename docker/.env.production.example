# Production environment — copy to nova-cloud/.env on server
# NEVER commit real secrets to git

NODE_ENV=production
PORT=3847

POSTGRES_USER=nova
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nova_cloud
DATABASE_URL=postgresql://nova:CHANGE_ME@postgres:5432/nova_cloud

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_CHARS_RANDOM

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Nova Browser <noreply@novabrowser.app>

APP_URL=https://novabrowser.app
CORS_ORIGINS=https://novabrowser.app,nova://*

SEARCH_CACHE_TTL=3600
