# Nova Cloud Configuration
NODE_ENV=development
PORT=3847
API_BASE_URL=http://localhost:3847

# SQLite (default — no Docker needed). For production use PostgreSQL:
DATABASE_URL=sqlite:./data/nova-cloud.db
# DATABASE_URL=postgresql://nova:nova_secret@localhost:5432/nova_cloud

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Email (SMTP) — verification & password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nova Browser <noreply@novabrowser.app>
APP_URL=http://localhost:5173

# Search cache TTL (seconds)
SEARCH_CACHE_TTL=3600

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,nova://*
